{
  "protocol": "Same selection rule for every method: one setting per method, chosen on all dev sets.\n\n``segbench.py`` gives only \u0394Context v3 a \"universal\" setting (best mean dev J over\nthe LongMemEval, SuperDialseg and TIAGE dev splits). This script applies that rule\nto every baseline too, scores each universal setting once on the four test sets,\nand compares \u0394Context v3 (universal) against each with a paired bootstrap, Holm-\ncorrected within each dataset. DialSeg711 is unseen by every method.\n\nUsage:\n    python scripts/segbench_universal.py --out paper/results/segbench_universal.json\n",
  "universal": {
    "Fixed-size chunks": {
      "size": 2
    },
    "Adjacent-turn threshold": {
      "theta": 0.75
    },
    "Semantic chunking": {
      "p": 85
    },
    "TextTiling": {
      "block": 4,
      "cutoff_std": 0.0
    },
    "\u0394Context v2 (displacement)": {
      "detector": "accumulator",
      "accumulator": "displacement",
      "change_threshold": 0.65,
      "window": 2,
      "min_snapshot_gap": 1,
      "localize_boundaries": true
    },
    "\u0394Context v3 (universal)": {
      "detector": "lookahead",
      "lookahead": 2,
      "left_context": 3,
      "threshold_mode": "zscore",
      "change_threshold": 1.0,
      "min_segment_turns": 1
    }
  },
